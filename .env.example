# ---------------------------------------------------------------------------
# Locora — environment contract
#
# Copy to `.env.local` for development. Never put real values in this file.
# Every variable is labelled REQUIRED, OPTIONAL or AUTO:
#   REQUIRED — the app refuses to start in production without it
#   OPTIONAL — has a safe default; set it to change behaviour
#   AUTO     — Vercel injects it; do not set it by hand
# ---------------------------------------------------------------------------

# REQUIRED — Neon Postgres connection string.
# Use the *pooled* endpoint (the host contains `-pooler`) so serverless
# invocations reuse Neon's connection pool instead of opening their own.
# Paste it exactly as Neon gives it to you, `?sslmode=require` included.
DATABASE_URL=

# REQUIRED in production — signing key for session tokens.
# Generate with: openssl rand -hex 32
# Rotating this value invalidates every session and logs everyone out.
AUTH_SECRET=

# REQUIRED in production — grants the admin role to exactly this address the
# first time it registers (or on the next migration run if it already exists).
# This is the only way to create the first admin without a SQL console.
# Remove it once that account can promote others from the moderation console.
INITIAL_ADMIN_EMAIL=

# REQUIRED in production — Vercel Blob read/write token for report photos.
# Vercel injects this automatically once a Blob store is linked to the project,
# in which case leave it blank here.
BLOB_READ_WRITE_TOKEN=

# OPTIONAL — canonical public origin, used for links in emails and for
# Open Graph metadata. On Vercel this is derived automatically from
# VERCEL_PROJECT_PRODUCTION_URL, so it only needs setting for a custom domain.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL — email delivery. `console` (default) writes the message to the
# server log, which is what local development wants. `smtp` sends for real and
# requires every SMTP_* value below.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=

# OPTIONAL — require a verified email address before a user may file a report.
# On by default: an unverified address costs nothing to create, so without this
# one script can fill the moderation queue faster than a human can clear it.
REQUIRE_VERIFIED_EMAIL_TO_REPORT=true

# AUTO — set by Vercel. Listed so their role is documented, not so you set them.
# VERCEL_ENV
# VERCEL_URL
# VERCEL_PROJECT_PRODUCTION_URL
